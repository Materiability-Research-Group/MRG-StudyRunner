{
  "api_version": 5,
  "plugin_key": "nextcloud",
  "version": "1.1.1",
  "category": "storage",
  "config_key": "nextcloud",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": [
      "runtime",
      "diagnostics"
    ],
    "sample_delivery": "none",
    "actions": [],
    "trial_events": [],
    "can_toggle": false,
    "operation_timeouts_ms": {
      "publish": 1800000,
      "admin_action": 30000
    },
    "sidecar": {}
  },
  "ui": {
    "label": "Nextcloud upload",
    "description": "Mirrors immutable session artifacts to a Nextcloud share.",
    "help_key": "pluginHelp.nextcloud.intro",
    "order": 610,
    "visibility": {
      "dashboard": false,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": true
    }
  },
  "capabilities": {
    "upload_destination": {
      "destination": "nextcloud",
      "default_enabled": false,
      "requires_valid_result": true,
      "publish_on_attention": false,
      "republish_on_degraded": false,
      "purge_verified_sources": false,
      "legacy": {
        "enabled_field": "nextcloud_enabled",
        "settings": {
          "share_link": "nextcloud_share_link"
        }
      }
    },
    "readiness_requirements": {
      "requires_settings": [
        "share_link"
      ],
      "requires_machine_enabled": true
    },
    "health": {},
    "study_settings": {},
    "credentials": {
      "config_field": "password",
      "env_var": "STUDY_RUNNER_NEXTCLOUD_PASSWORD",
      "per_study": true,
      "label_key": "pluginSettings.nextcloud.password.label",
      "placeholder_key": "pluginSettings.nextcloud.password.placeholder",
      "help_key": "pluginHelp.nextcloud.password"
    },
    "admin_actions": {
      "actions": [
        {
          "key": "test_connection",
          "label": "Test connection",
          "payload_schema": {
            "share_link": {
              "type": "string",
              "required": true,
              "max_length": 2048
            },
            "password": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "study_id": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "timeout_seconds": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 120
            }
          }
        }
      ]
    }
  },
  "streams": [],
  "settings": {
    "machine": {
      "enabled": {
        "type": "boolean",
        "path": "enabled",
        "default": true,
        "label_key": "pluginSettings.common.enabled",
        "help_key": "pluginHelp.destination.enabled",
        "apply": "immediate",
        "scope": "machine"
      },
      "timeout_seconds": {
        "type": "number",
        "unit": "s",
        "path": "timeout_seconds",
        "default": 30,
        "minimum": 1,
        "maximum": 120,
        "label_key": "pluginSettings.common.timeoutSeconds",
        "help_key": "pluginHelp.destination.timeoutSeconds",
        "apply": "immediate",
        "scope": "machine"
      },
      "auto_retry": {
        "type": "boolean",
        "path": "auto_retry",
        "default": true,
        "label_key": "pluginSettings.destination.autoRetry",
        "help_key": "pluginHelp.destination.autoRetry",
        "apply": "immediate",
        "scope": "machine"
      },
      "retry_hours": {
        "type": "number",
        "unit": "h",
        "path": "retry_hours",
        "default": 48,
        "minimum": 1,
        "maximum": 168,
        "label_key": "pluginSettings.destination.retryHours",
        "help_key": "pluginHelp.destination.retryHours",
        "apply": "immediate",
        "scope": "machine"
      }
    },
    "study": {
      "share_link": {
        "type": "url",
        "format": "nextcloud_public_share",
        "default": "",
        "label_key": "pluginSettings.nextcloud.shareLink.label",
        "placeholder_key": "pluginSettings.nextcloud.shareLink.placeholder",
        "help_key": "pluginHelp.nextcloud.shareLink"
      }
    },
    "card_actions": {}
  },
  "poll_interval_ms": 5000,
  "request_timeout_ms": 1000,
  "clock_domain": "server",
  "expected_data_rate": {},
  "backpressure": {
    "max_in_flight": 1,
    "drop_policy": "upload_job_queue"
  }
}
