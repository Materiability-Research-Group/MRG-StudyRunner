{
  "api_version": 5,
  "plugin_key": "notion",
  "version": "1.4.3",
  "category": "storage",
  "config_key": "notion",
  "runtime": {
    "entrypoint": "driver.py",
    "protocol": "study-runner-stdio/v1",
    "interactive_stdin": true,
    "modes": [
      "runtime",
      "diagnostics"
    ],
    "sample_delivery": "none",
    "actions": [],
    "trial_events": [],
    "can_toggle": true,
    "operation_timeouts_ms": {
      "publish": 300000,
      "admin_action": 30000
    },
    "sidecar": {}
  },
  "lifecycle": {
    "reinitialize_on_disable": true
  },
  "ui": {
    "label": "Notion upload",
    "description": "Publishes finalized result and card-summary JSON to Notion.",
    "help_key": "pluginHelp.notion.intro",
    "order": 600,
    "visibility": {
      "dashboard": false,
      "settings_hub": true,
      "study_settings": true,
      "destination_settings": true
    },
    "extensions": {
      "study_settings": "ui/configurator.js"
    },
    "assets": [
      "ui/configurator-node-view.js",
      "ui/node-canvas.js"
    ]
  },
  "capabilities": {
    "upload_destination": {
      "destination": "notion",
      "default_enabled": false,
      "requires_valid_result": true,
      "publish_on_attention": false,
      "republish_on_degraded": false,
      "purge_verified_sources": false,
      "discovered_settings": [
        "database_id",
        "data_source_id",
        "sessions_database_id"
      ],
      "legacy": {
        "enabled_field": "notion_enabled",
        "settings": {
          "parent_page_id": "notion_parent_page_id",
          "database_id": "notion_database_id",
          "data_source_id": "notion_data_source_id"
        }
      }
    },
    "readiness_requirements": {
      "requires_secret": true,
      "requires_settings": [
        "parent_page_id",
        "database_id"
      ],
      "requires_machine_enabled": true
    },
    "health": {},
    "machine_settings": {},
    "study_settings": {},
    "credentials": {
      "config_field": "api_key",
      "env_var": "STUDY_RUNNER_NOTION_API_KEY",
      "per_study": true,
      "label_key": "pluginSettings.notion.apiKey.label",
      "placeholder_key": "pluginSettings.notion.apiKey.placeholder",
      "help_key": "pluginHelp.notion.apiKey"
    },
    "admin_actions": {
      "actions": [
        {
          "key": "test_connection",
          "label": "Test connection",
          "payload_schema": {
            "api_key": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "parent_page_id": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "database_id": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "study_id": {
              "type": "string",
              "required": false,
              "max_length": 256
            },
            "timeout_seconds": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 120
            }
          }
        },
        {
          "key": "list_children",
          "label": "List page children",
          "payload_schema": {
            "api_key": { "type": "string", "required": false, "max_length": 256 },
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "page_id": { "type": "string", "required": true, "max_length": 256 },
            "cursor": { "type": "string", "required": false, "max_length": 512 }
          }
        },
        {
          "key": "describe_database",
          "label": "Describe a database",
          "payload_schema": {
            "api_key": { "type": "string", "required": false, "max_length": 256 },
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "database_id": { "type": "string", "required": true, "max_length": 256 }
          }
        },
        {
          "key": "create_database",
          "label": "Create a database",
          "payload_schema": {
            "api_key": { "type": "string", "required": false, "max_length": 256 },
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "parent_page_id": { "type": "string", "required": true, "max_length": 256 },
            "title": { "type": "string", "required": true, "max_length": 200 },
            "row_level": { "type": "string", "required": true, "enum": ["session", "participant", "card"] },
            "columns_json": { "type": "string", "required": true, "max_length": 20000 },
            "key_column": { "type": "string", "required": false, "max_length": 100 }
          }
        },
        {
          "key": "describe_output_catalog",
          "label": "List fixed output sources for this study",
          "payload_schema": {
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "config_data_json": { "type": "string", "required": true, "max_length": 200000 }
          }
        },
        {
          "key": "describe_session_sources",
          "label": "List sources available from a session",
          "payload_schema": {
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "session_path": { "type": "string", "required": true, "max_length": 512 }
          }
        },
        {
          "key": "preview_mapping",
          "label": "Preview with a session",
          "payload_schema": {
            "study_id": { "type": "string", "required": false, "max_length": 256 },
            "mapping_json": { "type": "string", "required": true, "max_length": 200000 },
            "session_path": { "type": "string", "required": true, "max_length": 512 }
          }
        }
      ]
    }
  },
  "streams": [],
  "settings": {
    "machine": {
      "enabled": {
        "type": "boolean",
        "path": "enabled",
        "default": true,
        "label_key": "pluginSettings.common.enabled",
        "help_key": "pluginHelp.destination.enabled",
        "apply": "immediate",
        "scope": "machine"
      },
      "timeout_seconds": {
        "type": "number",
        "unit": "s",
        "path": "timeout_seconds",
        "default": 10,
        "minimum": 1,
        "maximum": 120,
        "label_key": "pluginSettings.common.timeoutSeconds",
        "help_key": "pluginHelp.destination.timeoutSeconds",
        "apply": "immediate",
        "scope": "machine"
      },
      "auto_retry": {
        "type": "boolean",
        "path": "auto_retry",
        "default": true,
        "label_key": "pluginSettings.destination.autoRetry",
        "help_key": "pluginHelp.destination.autoRetry",
        "apply": "immediate",
        "scope": "machine"
      },
      "retry_hours": {
        "type": "number",
        "unit": "h",
        "path": "retry_hours",
        "default": 48,
        "minimum": 1,
        "maximum": 168,
        "label_key": "pluginSettings.destination.retryHours",
        "help_key": "pluginHelp.destination.retryHours",
        "apply": "immediate",
        "scope": "machine"
      }
    },
    "study": {
      "parent_page_id": {
        "type": "string",
        "default": "",
        "label_key": "pluginSettings.notion.parentPageId.label",
        "placeholder_key": "pluginSettings.notion.parentPageId.placeholder",
        "help_key": "pluginHelp.notion.parentPageId"
      },
      "database_id": {
        "type": "string",
        "default": "",
        "label_key": "pluginSettings.notion.databaseId.label",
        "placeholder_key": "pluginSettings.notion.databaseId.placeholder",
        "help_key": "pluginHelp.notion.databaseId"
      },
      "data_source_id": {
        "type": "string",
        "default": "",
        "read_only": true,
        "label_key": "pluginSettings.notion.dataSourceId.label",
        "placeholder_key": "pluginSettings.notion.dataSourceId.placeholder",
        "help_key": "pluginHelp.notion.dataSourceId"
      },
      "sessions_database_id": {
        "type": "string",
        "default": "",
        "read_only": true,
        "label_key": "pluginSettings.notion.sessionsDatabaseId.label",
        "placeholder_key": "pluginSettings.notion.dataSourceId.placeholder",
        "help_key": "pluginHelp.notion.sessionsDatabaseId"
      },
      "export_mapping": {
        "type": "object",
        "default": {},
        "max_length": 200000,
        "label_key": "pluginSettings.notion.exportMapping.label",
        "help_key": "pluginHelp.notion.exportMapping"
      }
    },
    "card_actions": {}
  },
  "poll_interval_ms": 5000,
  "request_timeout_ms": 1000,
  "clock_domain": "server",
  "expected_data_rate": {},
  "backpressure": {
    "max_in_flight": 1,
    "drop_policy": "upload_job_queue"
  }
}
